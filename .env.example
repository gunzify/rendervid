# ===== RenderVid AI environment =====
# Copy to .env (apps/web) and .env (worker). NEVER commit real values.

APP_URL=http://localhost:3000

# --- Database (Supabase Postgres or any Postgres) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rendervid

# --- Supabase Auth ---
# Leave SUPABASE_URL EMPTY to run auth in local dev mode (see DEV_AUTH below).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Local dev auth (zero external services) ---
# When SUPABASE_URL is empty (or DEV_AUTH=local), signup/signin store scrypt-hashed
# credentials in a local dev_credentials table and issue HS256 tokens signed with
# SUPABASE_JWT_SECRET or APP_SECRET. /api/credits/dev-topup is also enabled.
# Set DEV_AUTH=supabase (or configure SUPABASE_URL) in any real deployment.
#DEV_AUTH=local
APP_SECRET=dev-secret-change-me

# --- Redis (BullMQ). Leave QUEUE_MODE=inline to run jobs in-process without Redis. ---
QUEUE_MODE=inline
REDIS_URL=redis://localhost:6379

# --- Generation provider: mock | live ---
PROVIDER_MODE=mock
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
HIGGSFIELD_WEBHOOK_SECRET=

# --- AI Director: falls back to deterministic heuristics if key is empty ---
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# --- Stripe (use test keys) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_AGENCY=

# --- Storage: local | r2 ---
STORAGE_MODE=local
STORAGE_LOCAL_DIR=./storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# --- Observability (optional) ---
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# --- Mobile app (apps/mobile) ---
EXPO_PUBLIC_API_URL=http://localhost:3000
